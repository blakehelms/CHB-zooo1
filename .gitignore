# Default deny: only reviewed source/tooling enters Git.
*
!/.gitignore
!/README.md
!/AGENTS.md
!/tools/
!/tools/*.py
!/tests/
!/tests/*.py
!/docs/
!/docs/*.md
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/release/
!/release/qualified-runtime.json
!/app/
!/app/zooo1/
!/app/zooo1/__init__.py
!/app/zooo1/acquisition.py
!/app/zooo1/storage.py
!/app/zooo1/experiments.py
!/app/zooo1/muse.py
!/app/zooo1/controller.py
!/app/zooo1/viewer.py
!/app/zooo1/web.py
!/app/zooo1/static/
!/app/zooo1/static/index.html
!/app/zooo1/static/app.js
!/app/zooo1/static/style.css
!/app/scripts/
!/app/scripts/check-runtime.py
!/app/requirements.txt
!/app/requirements-viewer.txt
# Never force-add device settings, credentials, auth/password hashes, raw recordings,
# journals, research data, .local, environments or local candidate/backup archives.

!/app/LAUNCH.sh
!/app/INSTALL.sh
!/app/zooo1/__main__.py
!/release/requirements-pi-qualified.txt
